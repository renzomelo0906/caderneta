{
  "name": "caderneta",
  "version": "1.1.0",
  "description": "Controle acadêmico: notas, horário, calendário e desempenho",
  "author": "Renzo",
  "main": "main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "icon": "electron scripts/make-icon.cjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test.mjs",
    "smoke": "npm run build && electron scripts/smoke.cjs"
  },
  "devDependencies": {
    "@fontsource-variable/recursive": "^5.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "45.1.0",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.540.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.renzo.caderneta",
    "productName": "Caderneta",
    "files": [
      "dist/**/*",
      "main.js",
      "preload.js",
      "vault.js",
      "build/icon.png"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Caderneta"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true,
    "electron@45.1.0": true
  }
}
